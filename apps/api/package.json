{
  "name": "@fairride/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply fairride --local",
    "db:migrate:remote": "wrangler d1 migrations apply fairride --remote",
    "db:studio": "wrangler d1 execute fairride --local --command \"SELECT name FROM sqlite_master WHERE type='table'\""
  },
  "dependencies": {
    "@fairride/shared": "*",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "~4.1.0",
    "wrangler": "^4.147.0"
  }
}
