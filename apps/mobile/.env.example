# Copy to .env (or .env.local) and adjust. Expo only inlines variables prefixed
# with EXPO_PUBLIC_, and only from the app's own directory.
#
# Deployed Worker:
EXPO_PUBLIC_API_URL=https://fairride-api.polemoroke.workers.dev
#
# Local `wrangler dev` alternatives:
#   iOS simulator / web:  http://localhost:8787
#   Android emulator:      http://10.0.2.2:8787
#   Physical device (LAN): http://192.168.1.50:8787

# Google Maps SDK key. The Android key is also embedded in app.json
# (android.config.googleMaps.apiKey) because the native map needs it at prebuild
# time. Restrict it in Google Cloud Console to the package com.polecreates.fairride.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
