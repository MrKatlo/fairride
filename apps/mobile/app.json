{
  "expo": {
    "name": "FairRide",
    "slug": "fairride",
    "scheme": "fairride",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.polecreates.fairride",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FairRide uses your location to match you with drivers and to show your driver approaching."
      }
    },
    "android": {
      "package": "com.polecreates.fairride",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD77_wt6b3pEoXLWq2YtdULkBBgUR2StiQ"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FairRide uses your location while the app is open to match rides and share trip progress."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a864b56-bf89-4e40-bf44-bcb4158e608a"
      }
    },
    "owner": "polecreates"
  }
}
